{
  "name": "nano-cloud-codec",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Nano Cloud Codec (SNCA) — GF(2^8) Cauchy MDS engine for web and native WebViews",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "wasm": "cd wasm && bash build.sh && mkdir -p ../public && cp build/snca_codec.js build/snca_codec.wasm ../public/",
    "test": "node tests/cauchy_mds.test.mjs",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  }
}
